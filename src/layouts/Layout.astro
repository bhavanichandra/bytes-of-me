---
// Shared page layout: theme (light/dark), grain background, sticky-note
// corner panel on every page.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PixelIcon from "../components/PixelIcon.astro";
import { CLOCK, EMAIL, GITHUB, LINKEDIN, PROFILE } from "../lib/pixelIcons";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
}

const {
  title,
  description = "Bhavani Chandra's personal site — writing, projects and the daily log, in one feed.",
  image,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image.src, Astro.site) : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <ClientRouter />

    <script is:inline>
      // Site-wide light/dark, persisted. Runs once per real page load,
      // before anything paints (no flash), and again on client-side
      // view-transition navigation (ClientRouter swaps <body> without a
      // full reload, so this needs to run there too).
      function applyTheme() {
        var stored = localStorage.getItem("theme");
        document.documentElement.dataset.theme = stored === "light" ? "light" : "dark";
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body class="grain-bg transition-colors duration-200 bg-[var(--bg)] text-[var(--ink)]">
    <slot />

    <div id="corner-panel" class="corner-panel fixed top-4 right-4 md:top-8 md:right-8 z-50 group w-fit flex items-center gap-3 text-[var(--ink)]">
      <a
        href="/now"
        aria-label="Now"
        title="Now"
        class="w-7 h-7 flex items-center justify-center rounded-full border border-[var(--border)] transition opacity-70 hover:opacity-100"
      >
        <PixelIcon bitmap={CLOCK} size={1.4} />
      </a>

      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle light/dark theme"
        class="w-7 h-7 flex items-center justify-center rounded-full border border-[var(--border)] transition opacity-70 hover:opacity-100"
      >
        <svg data-theme-icon-dark viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.5A8.5 8.5 0 1 1 11.5 3a7 7 0 0 0 9.5 9.5Z"/></svg>
        <svg data-theme-icon-light viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" class="hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>

      <div class="relative">
        <button
          type="button"
          class="corner-avatar block w-10 h-10 md:w-12 md:h-12 rounded-full overflow-hidden border-2 border-[var(--border)] shadow-lg shadow-black/50 transition"
          aria-label="Open menu"
          aria-haspopup="true"
        >
          <img src="/my-photo.svg" alt="Profile" class="w-full h-full object-cover" />
        </button>
        <div
          class="absolute top-full right-0 mt-3 flex flex-col items-center gap-3 border border-[var(--border)] bg-[var(--surface)] rounded-full px-3 pt-4 pb-6 opacity-0 -translate-y-3 scale-95 origin-top pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 group-hover:pointer-events-auto group-[.is-open]:opacity-100 group-[.is-open]:translate-y-0 group-[.is-open]:scale-100 group-[.is-open]:pointer-events-auto transition-all duration-200 ease-out"
        >
          <a href="/about" class="hover:opacity-70 transition" aria-label="About"><PixelIcon bitmap={PROFILE} size={2} /></a>
          <a href="mailto:bhavanichandra9+site@gmail.com" class="hover:opacity-70 transition" aria-label="Email"><PixelIcon bitmap={EMAIL} size={2} /></a>
          <a href="https://github.com/bhavanichandra" target="_blank" rel="noopener noreferrer" class="hover:opacity-70 transition" aria-label="GitHub"><PixelIcon bitmap={GITHUB} size={2} /></a>
          <a href="https://www.linkedin.com/in/bhavanichandra/" target="_blank" rel="noopener noreferrer" class="hover:opacity-70 transition" aria-label="LinkedIn"><PixelIcon bitmap={LINKEDIN} size={2} /></a>
        </div>
      </div>
    </div>

    <script>
      // The menu previews on hover on devices that have one; the avatar
      // button also toggles it via click/tap so touch devices (which
      // have no hover state) can open it in a single tap. A tap/click
      // outside the panel closes it again.
      function initCornerPanel() {
        const panel = document.getElementById("corner-panel");
        const avatar = panel?.querySelector<HTMLButtonElement>(".corner-avatar");
        if (!panel || !avatar || panel.dataset.bound === "true") return;
        panel.dataset.bound = "true";

        avatar.addEventListener("click", () => {
          panel.classList.toggle("is-open");
        });
        document.addEventListener("click", (e) => {
          if (!panel.contains(e.target as Node)) panel.classList.remove("is-open");
        });
      }

      function initThemeToggle() {
        const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
        if (!btn || btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";

        const darkIcon = btn.querySelector("[data-theme-icon-dark]")!;
        const lightIcon = btn.querySelector("[data-theme-icon-light]")!;

        function sync() {
          const isLight = document.documentElement.dataset.theme === "light";
          darkIcon.classList.toggle("hidden", isLight);
          lightIcon.classList.toggle("hidden", !isLight);
        }
        sync();

        btn.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("theme", next);
          sync();
        });
      }

      document.addEventListener("astro:page-load", initCornerPanel);
      document.addEventListener("astro:page-load", initThemeToggle);
      initCornerPanel();
      initThemeToggle();
    </script>
  </body>
</html>
