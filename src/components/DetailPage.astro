---
// Shared shell for blog posts and project case studies — section nav is
// auto-derived from h2 headings, no per-page setup needed.
import Layout from "../layouts/Layout.astro";
import Tag from "./Tag.astro";
import CommentsPanel from "./CommentsPanel.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date: string;
  tags?: string[];
  href?: string;
  cover?: ImageMetadata;
  backHref: string;
  backLabel: string;
  headings?: Heading[];
  /** Giscus `term` — pass a fixed frontmatter slug, only from blog posts. */
  commentsTerm?: string;
}

const {
  title,
  description,
  date,
  tags = [],
  href,
  cover,
  backHref,
  backLabel,
  headings = [],
  commentsTerm,
} = Astro.props;

const sectionHeadings = headings.filter((h) => h.depth === 2);
---

<Layout title={`${title} — Bhavani Chandra`} description={description} image={cover}>
  <a
    href={backHref}
    class="fixed top-8 left-8 text-xs uppercase tracking-widest text-[var(--ink-muted)] hover:text-[var(--ink)] transition z-50"
  >
    ← {backLabel}
  </a>

  {sectionHeadings.length > 0 && (
    <nav class="hidden lg:flex lg:flex-col lg:gap-2 lg:fixed lg:top-24 lg:left-8 lg:w-48 lg:z-40">
      {sectionHeadings.map((h) => (
        <a
          href={`#${h.slug}`}
          class="text-sm text-[var(--ink-muted)] hover:text-[var(--ink)] transition"
        >
          {h.text}
        </a>
      ))}
    </nav>
  )}

  <main class="pl-6 pr-14 md:pl-8 md:pr-12 pt-20 pb-24">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h1 class="font-serif text-3xl text-[var(--ink)] mb-3 leading-snug">{title}</h1>
      {description && <p class="max-w-2xl mx-auto text-[var(--ink-muted)] leading-relaxed">{description}</p>}
      <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
        <span class="text-xs text-[var(--ink-faint)]">{date}</span>
        {href && (
          <>
            <span class="text-[var(--border)]">|</span>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-blue-400 hover:text-blue-300 transition"
            >
              Visit site
            </a>
          </>
        )}
        {tags.length > 0 && (
          <span class="flex gap-1.5">
            {tags.map((tag) => (
              <Tag label={tag} />
            ))}
          </span>
        )}
      </div>
    </div>

    <div class="flex flex-col md:flex-row lg:justify-center gap-12">
      {sectionHeadings.length > 0 && (
        <nav class="md:w-48 shrink-0 lg:hidden">
          <div class="flex flex-row md:flex-col gap-3 md:gap-2 flex-wrap md:sticky md:top-20">
            {sectionHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class="text-sm text-[var(--ink-muted)] hover:text-[var(--ink)] transition"
              >
                {h.text}
              </a>
            ))}
          </div>
        </nav>
      )}
      <article class="prose-body font-serif text-[var(--ink-muted)] leading-relaxed flex-1 min-w-0 max-w-4xl">
        <slot />
        {commentsTerm && <CommentsPanel term={commentsTerm} />}
      </article>
    </div>
  </main>
</Layout>
