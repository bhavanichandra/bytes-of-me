---
// Shared shell for blog posts and project case studies — a Fowler-style
// "Contents" box is auto-derived from h2/h3 headings, no per-page setup
// needed.
import Layout from "../layouts/Layout.astro";
import Tag from "./Tag.astro";
import CommentsPanel from "./CommentsPanel.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date: string;
  tags?: string[];
  href?: string;
  cover?: ImageMetadata;
  backHref: string;
  backLabel: string;
  headings?: Heading[];
  /** Giscus `term` — pass a fixed frontmatter slug, only from blog posts. */
  commentsTerm?: string;
}

const {
  title,
  description,
  date,
  tags = [],
  href,
  cover,
  backHref,
  backLabel,
  headings = [],
  commentsTerm,
} = Astro.props;

const sectionHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={`${title} — Bhavani Chandra`} description={description} image={cover}>
  <a
    href={backHref}
    class="fixed top-8 left-8 text-xs uppercase tracking-widest text-[var(--ink-muted)] hover:text-[var(--ink)] transition z-50"
  >
    ← {backLabel}
  </a>

  <main class="pl-6 pr-14 md:pl-8 md:pr-12 pt-20 pb-24">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h1 class="font-serif text-3xl text-[var(--ink)] mb-3 leading-snug">{title}</h1>
      {description && <p class="font-sans max-w-2xl mx-auto text-[var(--ink-muted)] leading-relaxed">{description}</p>}
      <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
        <span class="text-xs font-pixel text-[var(--ink-faint)]">{date}</span>
        {href && (
          <>
            <span class="text-[var(--border)]">|</span>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[var(--ink-muted)] hover:text-[var(--ink)] transition-colors"
            >
              Visit site
            </a>
          </>
        )}
        {tags.length > 0 && (
          <span class="flex gap-1.5">
            {tags.map((tag) => (
              <Tag label={tag} />
            ))}
          </span>
        )}
      </div>
    </div>

    <div class="flex flex-col lg:flex-row lg:justify-center gap-12">
      <article class="order-2 lg:order-1 prose-body font-sans text-[var(--ink-muted)] leading-relaxed flex-1 min-w-0 max-w-4xl">
        <slot />
        {commentsTerm && <CommentsPanel term={commentsTerm} />}
      </article>

      {sectionHeadings.length > 0 && (
        <aside class="order-1 lg:order-2 lg:w-64 shrink-0">
          <div class="border border-[var(--border)] p-5 lg:sticky lg:top-24">
            <div class="text-xs font-mono uppercase tracking-widest text-[var(--ink-faint)] mb-3">Contents</div>
            <nav class="flex flex-col gap-2.5">
              {sectionHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class:list={[
                    "text-sm transition-colors text-[var(--ink-muted)] hover:text-[var(--ink)]",
                    h.depth === 3 && "pl-3 text-xs",
                  ]}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </main>
</Layout>
