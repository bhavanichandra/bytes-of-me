---
// The site's one content feed: every blog post, project and journal
// entry, merged into one searchable list. No separate Blogs/Projects/
// Journal pages.
import FeedRow from "./FeedRow.astro";
import type { UnifiedPost } from "../lib/content";

interface Props {
  posts: UnifiedPost[];
}
const { posts } = Astro.props;
---

<div class="feed" data-feed>
  <div class="flex flex-wrap items-center gap-3 mb-5">
    <input
      type="date"
      data-feed-date
      class="border border-[var(--border)] bg-transparent px-3 py-2 text-sm text-[var(--ink)] outline-none focus:border-cyan-400/60"
    />

    <input
      type="search"
      placeholder="Search…"
      data-feed-search
      class="flex-1 min-w-[12rem] ml-auto border border-[var(--border)] bg-transparent px-3 py-2 text-sm text-[var(--ink)] outline-none focus:border-cyan-400/60"
    />
  </div>

  <div class="rows-list flex flex-col gap-1.5">
    {posts.length === 0 && <p class="text-sm text-[var(--ink-muted)]">Nothing here yet.</p>}
    {posts.map((post) => <FeedRow {post} />)}
    <p data-no-matches class="hidden text-sm py-4 text-[var(--ink-muted)]">No matches.</p>
  </div>
</div>

<script>
  function initFeed(root: HTMLElement) {
    if (root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const search = root.querySelector<HTMLInputElement>("[data-feed-search]")!;
    const dateFilter = root.querySelector<HTMLInputElement>("[data-feed-date]")!;
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-filter-item]"));
    const noMatches = root.querySelector<HTMLElement>("[data-no-matches]")!;

    function applyFilters() {
      const q = search.value.trim().toLowerCase();
      const d = dateFilter.value;
      let visible = 0;
      items.forEach((item) => {
        const matchesDate = !d || item.dataset.filterDate === d;
        const matchesSearch = !q || (item.dataset.filterText ?? "").includes(q) || (item.dataset.filterDate ?? "").includes(q);
        const matches = matchesDate && matchesSearch;
        item.hidden = !matches;
        if (matches) visible++;
      });
      noMatches.classList.toggle("hidden", visible > 0 || items.length === 0);
    }

    search.addEventListener("input", applyFilters);
    dateFilter.addEventListener("input", applyFilters);
  }

  document.querySelectorAll<HTMLElement>("[data-feed]").forEach(initFeed);
</script>
