---
// The site's one content feed: every blog post, project and journal
// entry, merged into one searchable list. No separate Blogs/Projects/
// Journal pages.
import FeedRow from "./FeedRow.astro";
import type { UnifiedPost } from "../lib/content";

interface Props {
  posts: UnifiedPost[];
}
const { posts } = Astro.props;
---

<div class="feed" data-feed>
  <input
    type="search"
    placeholder="Search…"
    data-feed-search
    class="mb-5 w-full max-w-xs border border-[var(--border)] bg-transparent px-3 py-2 text-sm text-[var(--ink)] outline-none focus:border-cyan-400/60"
  />

  <div class="rows-list spotlight-group flex flex-col">
    {posts.length === 0 && <p class="text-sm text-[var(--ink-muted)]">Nothing here yet.</p>}
    {posts.map((post) => <FeedRow {post} />)}
    <p data-no-matches class="hidden text-sm py-4 text-[var(--ink-muted)]">No matches.</p>
  </div>
</div>

<script>
  function initFeed(root: HTMLElement) {
    if (root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const search = root.querySelector<HTMLInputElement>("[data-feed-search]")!;
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-filter-item]"));
    const noMatches = root.querySelector<HTMLElement>("[data-no-matches]")!;

    search.addEventListener("input", () => {
      const q = search.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const matches = !q || (item.dataset.filterText ?? "").includes(q) || (item.dataset.filterDate ?? "").includes(q);
        item.hidden = !matches;
        if (matches) visible++;
      });
      noMatches.classList.toggle("hidden", visible > 0 || items.length === 0);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-feed]").forEach(initFeed);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-feed]").forEach(initFeed);
  });
</script>
