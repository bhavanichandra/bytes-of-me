---
interface Props {
  label: string;
  size?: "sm" | "md";
}

const { label, size = "sm" } = Astro.props;
const padding =
  size === "md" ? "px-2 py-0.5 text-[11px]" : "px-1.5 py-0.5 text-[10px]";
---

<span
  role="button"
  tabindex="0"
  data-open-tag-panel={label}
  class={`inline-flex items-center font-pixel border border-(--border) text-(--ink-faint) hover:text-(--ink) hover:border-(--ink-faint) rounded-sm cursor-pointer transition ${padding}`}
>
  {label}
</span>
