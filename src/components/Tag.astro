---
interface Props {
  label: string;
  size?: "sm" | "md";
}

const { label, size = "sm" } = Astro.props;
const padding = size === "md" ? "px-2 py-0.5 text-[11px]" : "px-1.5 py-0.5 text-[10px]";
---

<span
  class={`inline-flex items-center uppercase tracking-wide border rounded-sm ${padding}`}
  style="border-color:var(--border); color:var(--ink-faint)"
>
  {label}
</span>
