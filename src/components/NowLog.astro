---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

// Dim, desaturated tones (like a muted terminal color scheme, e.g.
// journalctl/syslog level coloring) rather than bright UI accent colors —
// reads as incidental output, not a designed color code. Colors come
// from theme-aware CSS vars (global.css) since the dark-tuned hex values
// go muddy on the light background.
const LOG_LINES = [
  { tag: "BIO", color: "var(--log-bio)", value: "Full-stack engineer, Hyderabad. Infra to interface." },
  { tag: "THIS_MONTH", color: "var(--log-month)", value: "Working through AI/ML and system design courses." },
  { tag: "PROJECTS", color: "var(--log-projects)", value: "bytes-of-me, LLM fine-tuning, something new (soon)" },
  { tag: "HACKATHON", color: "var(--log-hackathon)", value: "OpenAI Build Week — hosted by Dev.to" },
];
---

<div class={`text-xs text-[var(--ink)] ${className}`}>
  <div class="text-[var(--ink-faint)] uppercase tracking-widest mb-3">Now</div>
  <div class="grid gap-y-2" style="grid-template-columns: max-content 1fr;">
    {LOG_LINES.map((line) => (
      <>
        <span class="pr-3 uppercase tracking-wide" style={`color: ${line.color};`}>{line.tag}</span>
        <span class="text-[var(--ink-muted)] leading-relaxed">{line.value}</span>
      </>
    ))}
  </div>
</div>
