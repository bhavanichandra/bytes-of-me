---
// The hero: name as the dominant element (the wordmark, per how
// martinfowler.com and similar sites actually do it — no page beats
// the name), with the role/headline as a clearly subordinate subtitle
// underneath, not a competing giant statement. transition:persist
// keeps it mounted (no flicker) across Astro view-transition navigation.
---

<div class="hero w-full pt-20" transition:persist transition:name="hero">
  <h1 id="hero-name" class="font-serif font-semibold leading-tight text-[var(--ink)] text-4xl md:text-5xl">
    <a href="/" class="hover:opacity-80 transition">Bhavani Chandra</a>
  </h1>
  <p id="hero-statement" class="font-serif mt-3 text-[var(--ink-muted)] text-lg md:text-xl max-w-2xl">
    Eight years wiring systems together. Now AI&rsquo;s one of them.
  </p>
</div>

<script>
  import { gsap } from "gsap";

  // Entrance plays once per browser tab, not on every in-app navigation —
  // replaying it on each view-transition swap read as the text flickering
  // away and back.
  const ANIMATED_KEY = "hero-animated";

  function animateHero() {
    const hero = document.querySelector(".hero");
    if (!hero) return;
    const lines = hero.querySelectorAll("#hero-name, #hero-statement");

    if (sessionStorage.getItem(ANIMATED_KEY)) {
      gsap.set(lines, { opacity: 1, y: 0 });
      return;
    }

    gsap.set(lines, { opacity: 0, y: 14 });
    gsap.to(lines, { opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: "power2.out" });
    sessionStorage.setItem(ANIMATED_KEY, "true");
  }

  if (!(window as any).__heroBound) {
    (window as any).__heroBound = true;
    document.addEventListener("astro:page-load", animateHero);
  }
  animateHero();
</script>
