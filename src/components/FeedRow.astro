---
// One row in the unified feed — a blog post, a project, or a journal
// entry, told apart only by a small stroke icon (the retro flare that
// stays). Journal entries have no detail page, so they render as a plain
// row with the note inline instead of a link.
import { Image } from "astro:assets";
import Tag from "./Tag.astro";
import PixelIcon from "./PixelIcon.astro";
import { BOOK, FOLDER, SHIELD } from "../lib/pixelIcons";
import type { UnifiedPost } from "../lib/content";

interface Props {
  post: UnifiedPost;
}
const { post } = Astro.props;

const ICONS = { blog: BOOK, project: FOLDER, journal: SHIELD } as const;
const ICON_COLOR = { blog: "#22d3ee", project: "#f87171", journal: "#f472b6" } as const;

const Wrapper = post.href ? "a" : "div";
const filterText = `${post.title} ${post.description ?? ""} ${(post.tags ?? []).join(" ")}`.toLowerCase();
---

<Wrapper
  href={post.href}
  data-filter-item
  data-filter-date={post.dateIso}
  data-filter-text={filterText}
  class={`row spotlight-item group flex flex-col md:flex-row items-start md:justify-between gap-3 md:gap-6 py-6 first:pt-0 border-b border-white/5 transition-opacity duration-300 ${post.href ? "" : "cursor-default"}`}
>
  <div class="flex items-start gap-4 min-w-0">
    {post.cover && (
      <Image
        src={post.cover}
        alt=""
        width={96}
        height={96}
        class="w-16 h-16 md:w-20 md:h-20 rounded-lg object-cover shrink-0"
      />
    )}
    <div class="flex flex-col gap-2 min-w-0">
      <h3 class="flex items-center gap-2 text-lg text-neutral-100 group-hover:text-white transition leading-snug">
        <PixelIcon bitmap={ICONS[post.type]} color={ICON_COLOR[post.type]} size={1.5} />
        {post.title}
      </h3>
      {post.description && (
        <p class="text-sm text-neutral-500 leading-relaxed max-w-md line-clamp-3">{post.description}</p>
      )}
    </div>
  </div>
  <div class="flex flex-row md:flex-col items-center md:items-end gap-2 shrink-0">
    <span class="text-xs text-neutral-500">{post.dateLabel}</span>
    {post.tags && post.tags.length > 0 && (
      <span class="flex gap-1.5">
        {post.tags.slice(0, 2).map((tag) => (
          <Tag label={tag} />
        ))}
      </span>
    )}
  </div>
</Wrapper>
