---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PageIntro from "../components/PageIntro.astro";
import Feed from "../components/Feed.astro";
import { getUnifiedPosts } from "../lib/content";

const posts = await getUnifiedPosts();
---

<Layout
  title="Bhavani Chandra"
  description="Bhavani Chandra's personal site — writing, projects and the daily log, in one feed."
>
  <div class="min-h-screen flex flex-col items-start">
    <Hero />
    <div class="w-full max-w-3xl px-8 md:px-12 mt-10">
      <PageIntro />
      <Feed {posts} />
    </div>
  </div>
</Layout>
