---
import Layout from "../layouts/Layout.astro";
import Rail from "../components/Rail.astro";
import PageIntro from "../components/PageIntro.astro";
import Feed from "../components/Feed.astro";
import { getUnifiedPosts } from "../lib/content";

const posts = await getUnifiedPosts();
---

<Layout
  title="Bhavani Chandra"
  description="Bhavani Chandra's personal site — writing, projects and the daily log, in one feed."
>
  <div class="flex flex-col md:grid md:grid-cols-[16rem_1fr] md:content-start min-h-screen">
    <Rail />
    <main class="contents">
      <div class="pt-20 pl-8 pr-20 md:px-8 md:col-start-2">
        <PageIntro />
      </div>
      <div class="pl-8 pr-20 md:px-8 pb-24 md:col-start-2">
        <Feed {posts} />
      </div>
    </main>
  </div>
</Layout>
