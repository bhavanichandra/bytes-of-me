---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PageIntro from "../components/PageIntro.astro";
import Feed from "../components/Feed.astro";
import { getUnifiedPosts } from "../lib/content";

const posts = await getUnifiedPosts();
---

<Layout
  title="Bhavani Chandra"
  description="Bhavani Chandra's personal site — writing and projects, in one feed."
>
  <div class="min-h-screen pl-6 pr-14 md:pl-8 md:pr-12 pt-20 pb-24">
    <div class="max-w-3xl mx-auto">
      <Hero />
      <div class="mt-16">
        <PageIntro />
        <Feed {posts} />
      </div>
    </div>
  </div>
</Layout>
